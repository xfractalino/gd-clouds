[configuration]

entry_symbol = "gd_clouds_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
macos.single.debug = "./bin/macos/libgd_clouds.macos.template_debug.dylib"
macos.double.debug = "./bin/macos/libgd_clouds.macos.template_debug.double.dylib"
macos.single.release = "./bin/macos/libgd_clouds.macos.template_release.dylib"
macos.double.release = "./bin/macos/libgd_clouds.macos.template_release.double.dylib"

ios.arm64.single.debug = "./bin/ios/libgd_clouds.ios.template_debug.arm64.dylib"
ios.arm64.double.debug = "./bin/ios/libgd_clouds.ios.template_debug.arm64.double.dylib"
ios.arm64.single.release = "./bin/ios/libgd_clouds.ios.template_release.arm64.dylib"
ios.arm64.double.release = "./bin/ios/libgd_clouds.ios.template_release.arm64.double.dylib"

windows.x86_32.single.debug = "./bin/windows/gd_clouds.windows.template_debug.x86_32.dll"
windows.x86_32.double.debug = "./bin/windows/gd_clouds.windows.template_debug.x86_32.double.dll"
windows.x86_32.single.release = "./bin/windows/gd_clouds.windows.template_release.x86_32.dll"
windows.x86_32.double.release = "./bin/windows/gd_clouds.windows.template_release.x86_32.double.dll"

windows.x86_64.single.debug = "./bin/windows/gd_clouds.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./bin/windows/gd_clouds.windows.template_debug.x86_64.double.dll"
windows.x86_64.single.release = "./bin/windows/gd_clouds.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./bin/windows/gd_clouds.windows.template_release.x86_64.double.dll"

linux.x86_64.single.debug = "./bin/linux/libgd_clouds.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "./bin/linux/libgd_clouds.linux.template_debug.x86_64.double.so"
linux.x86_64.single.release = "./bin/linux/libgd_clouds.linux.template_release.x86_64.so"
linux.x86_64.double.release = "./bin/linux/libgd_clouds.linux.template_release.x86_64.double.so"

linux.arm64.single.debug = "./bin/linux/libgd_clouds.linux.template_debug.arm64.so"
linux.arm64.double.debug = "./bin/linux/libgd_clouds.linux.template_debug.arm64.double.so"
linux.arm64.single.release = "./bin/linux/libgd_clouds.linux.template_release.arm64.so"
linux.arm64.double.release = "./bin/linux/libgd_clouds.linux.template_release.arm64.double.so"

linux.rv64.single.debug = "./bin/linux/libgd_clouds.linux.template_debug.rv64.so"
linux.rv64.double.debug = "./bin/linux/libgd_clouds.linux.template_debug.rv64.double.so"
linux.rv64.single.release = "./bin/linux/libgd_clouds.linux.template_release.rv64.so"
linux.rv64.double.release = "./bin/linux/libgd_clouds.linux.template_release.rv64.double.so"

android.x86_64.single.debug = "./bin/android/libgd_clouds.android.template_debug.x86_64.so"
android.x86_64.double.debug = "./bin/android/libgd_clouds.android.template_debug.x86_64.double.so"
android.x86_64.single.release = "./bin/android/libgd_clouds.android.template_release.x86_64.so"
android.x86_64.double.release = "./bin/android/libgd_clouds.android.template_release.x86_64.double.so"

android.arm64.single.debug = "./bin/android/libgd_clouds.android.template_debug.arm64.so"
android.arm64.double.debug = "./bin/android/libgd_clouds.android.template_debug.arm64.double.so"
android.arm64.single.release = "./bin/android/libgd_clouds.android.template_release.arm64.so"
android.arm64.double.release = "./bin/android/libgd_clouds.android.template_release.arm64.double.so"
